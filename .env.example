# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Shared secret proving the Next.js proxy to the API server. The API only
# honours a forwarded `x-user-id` when the caller also presents this value as
# `x-internal-token` (server/src/plugins/auth.ts). Must be identical in
# client/.env and server/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# Database — SQLite, created on first run by server/src/plugins/db.ts
SQLITE_DB_PATH=maily.db

# Stripe
STRIPE_SECRET_KEY=sk_test_...  # From Stripe Dashboard → API keys
STRIPE_WEBHOOK_SECRET=whsec_...  # From Stripe Dashboard → Webhooks

# Stripe Price IDs — read as STRIPE_PRICE_<PLAN> in server/src/routes/billing.ts
STRIPE_PRICE_PRO=price_...  # Pro plan price ID
STRIPE_PRICE_SCALE=price_...  # Scale plan price ID

# Stripe Product ID — the webhook maps this product to the `scale` plan,
# anything else to `pro` (server/src/routes/webhooks/stripe.ts)
STRIPE_PRODUCT_SCALE=prod_...

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:9000

# Temply's own Resend account — all built-in sends go through this key.
RESEND_API_KEY=
# The verified sender the app sends from. Users set a display name only.
SENDING_FROM_ADDRESS=send@temply.app
SENDING_FROM_LABEL=Temply

# ImageKit — image uploads. Private key stays server-side; public key +
# endpoint are handed to the browser to upload directly.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
