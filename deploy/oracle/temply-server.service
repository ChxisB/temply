[Unit]
Description=Temply API (Elysia on Bun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/temply/server
# Bun loads server/.env from the working directory.
Environment=NODE_ENV=production
Environment=PATH=__HOME__/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__HOME__/.bun/bin/bun src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
