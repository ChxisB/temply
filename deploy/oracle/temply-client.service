[Unit]
Description=Temply web (Next.js)
After=network-online.target temply-server.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/temply/client
Environment=NODE_ENV=production
Environment=PATH=__HOME__/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__HOME__/.bun/bin/bun run start -- --port 9000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
